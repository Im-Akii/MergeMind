# NVIDIA Nemotron (build.nvidia.com)
NVIDIA_API_KEY=
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL_INVESTIGATOR=nvidia/nemotron-3-super-120b-a12b
LLM_MODEL_FAST=nvidia/nemotron-3.5-lightning-30b-a3b
LLM_RPM=30

# neatlogs tracing (optional; tracing is off without it)
NEATLOGS_API_KEY=

# GitHub: a token for laptop mode, or GitHub App credentials
GITHUB_TOKEN=
GH_APP_ID=
GH_APP_KEY=

# Runtime
MERGEMIND_DB=mergemind.db
MERGEMIND_POLL_S=15
# Kill switch: can only lower the repo's autonomy (observe | suggest | invite | merge)
MERGEMIND_AUTONOMY=
# Fault injection, e.g. gh.comment:429@1,llm.api:500@1,llm.quick_triage:bad_json@1
MERGEMIND_FAULTS=
